# =============================================================================
#  Environment variables (secrets)
# -----------------------------------------------------------------------------
#  Copy this file to ".env" and fill in the values you need.
#  Anything set here OVERRIDES the matching value in config/config.json.
#  This keeps secrets (like API keys) out of your committed config file.
# =============================================================================

# --- Minecraft connection -----------------------------------------------------
# These override config.server.* when present.
MC_HOST=play.example.net
MC_PORT=25565
# For offline auth: any username. For microsoft auth: your Microsoft email.
MC_USERNAME=SupportBot
# Most cracked servers use "1.20.4". Leave blank to let mineflayer auto-detect.
MC_VERSION=

# Authentication mode: "offline" (cracked servers) or "microsoft" (premium).
# With "microsoft" you sign in once via a device code printed to the console;
# the token is then cached in MC_PROFILES_FOLDER so reconnects are silent.
MC_AUTH=offline
MC_PROFILES_FOLDER=.minecraft-auth

# --- OpenRouter AI (optional) -------------------------------------------------
# Get a key at https://openrouter.ai/keys
# If omitted, the !ai / !ask commands are disabled gracefully.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
